# --- Downloads and working data (large, regenerable, never commit) ---
downloads/
YT-Duo Downloads/
video/
audio/
recycle/
*.part
*.ytdl
*.temp

# --- User input / state ---
.ytduo/
# links.txt holds a personal queue; keep it local.
links.txt
config.json
*.log
.ytduo-archive.txt

# --- Build output ---
build/
dist/
*.spec.bak
*.exe
*.app/

# --- Secrets: never commit, under any name ---
.env
.env.*
secrets*
*.key
*.pem
cookies.txt

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
pip-wheel-metadata/
.eggs/

# --- Test scratch (tests clean up, but never commit one) ---
tests/_test-*/
tests/_guitest-*/
downy-test-*/
ytduo-test-*/
tmp*/
_*/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Local historical evidence
docs/archive/
# Local release binaries
Releases/*.zip
Releases/*.tar.gz

# Generated standalone launchers
Releases/*.sh
Releases/*.command

# Local portable runtime cache
.ytduo-runtime/
Releases/config.json

# Distribution output and runtime data
Releases/**/*.exe
Releases/**/*.zip
Releases/**/*.tar.gz
Releases/**/*.sh
Releases/**/*.command
